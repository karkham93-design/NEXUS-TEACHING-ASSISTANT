rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidUserProfile(data) {
      return data.keys().hasAll(['email', 'displayName']) &&
        data.keys().hasOnly(['email', 'displayName', 'level', 'points', 'streak', 'createdAt', 'updatedAt']) &&
        data.email is string && data.email.size() <= 150 &&
        data.displayName is string && data.displayName.size() <= 100 &&
        (!('level' in data) || (data.level is string && data.level.size() <= 50)) &&
        (!('points' in data) || (data.points is int && data.points >= 0)) &&
        (!('streak' in data) || (data.streak is int && data.streak >= 0));
    }

    function isValidUserLesson(data) {
      return data.keys().hasAll(['lessonId', 'title', 'completed']) &&
        data.keys().hasOnly(['lessonId', 'title', 'completed', 'score', 'lastAccessed']) &&
        data.lessonId is string && data.lessonId.size() <= 100 &&
        data.title is string && data.title.size() <= 200 &&
        data.completed is bool &&
        (!('score' in data) || (data.score is int && data.score >= 0 && data.score <= 100));
    }

    function isValidUserNote(data, userId) {
      return data.keys().hasAll(['userId', 'title', 'content']) &&
        data.keys().hasOnly(['userId', 'title', 'content', 'category', 'createdAt']) &&
        data.userId == userId &&
        data.title is string && data.title.size() <= 200 &&
        data.content is string && data.content.size() <= 10000 &&
        (!('category' in data) || (data.category is string && data.category.size() <= 50));
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isOwner(userId);

      // Lessons Progress Subcollection
      match /lessons/{lessonId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(lessonId) && isValidUserLesson(incoming());
        allow delete: if isOwner(userId);
      }

      // Notes Subcollection
      match /notes/{noteId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(noteId) && isValidUserNote(incoming(), userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
